# 服务
PORT=3000

# 数据库（docker-compose.dev.yml 起的本地 MySQL）
DATABASE_URL="mysql://jys:jys_dev_password@localhost:3306/jys"

# 缓存
REDIS_URL="redis://localhost:6379"

# 认证
JWT_SECRET="change-me-in-prod"
JWT_EXPIRES_IN="2h"

# 邮件（本地部署：组织 SMTP，配置化）
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# 上传（本地磁盘卷）
UPLOAD_DIR="/data/uploads"
