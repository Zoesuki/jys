{
  "name": "jys-monorepo",
  "private": true,
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev:web": "pnpm -F @jys/web dev",
    "dev:api": "pnpm -F @jys/api start:dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -F @jys/shared build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.31.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.14.0",
    "vue-eslint-parser": "^10.4.1"
  }
}
